                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 16,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "d8x-prom",
            "type": "prometheus"
          },
          "expr": "topk(10, sum by (symbol) (increase(liquidator_liquidations_total{chain=\"base_sepolia\", outcome=\"confirmed\"}[$__range])))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{symbol}}"
        }
